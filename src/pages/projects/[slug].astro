---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import MovieMateDemo from "../../components/MovieMateDemo.astro";
import SecureBankDemo from "../../components/SecureBankDemo.astro";
import TechTrackDemo from "../../components/TechTrackDemo.astro";
import IronCladDemo from "../../components/IronCladDemo.astro";
import TextWaveDemo from "../../components/TextWaveDemo.astro";
import StepsFlow from "../../components/StepsFlow.astro";
import KMeansDemo from "../../components/KMeansDemo.astro";
import LfsrDemo from "../../components/LfsrDemo.astro";
import CollinearDemo from "../../components/CollinearDemo.astro";
import LuhnDemo from "../../components/LuhnDemo.astro";
import FrequencyDemo from "../../components/FrequencyDemo.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, domain, tech, result, category, steps } = project.data;

const demos: Record<string, any> = {
  moviemate: MovieMateDemo,
  securebank: SecureBankDemo,
  techtrack: TechTrackDemo,
  ironclad: IronCladDemo,
  textwave: TextWaveDemo,
  "python-kmeans": KMeansDemo,
  "python-lfsr": LfsrDemo,
  "python-collinear": CollinearDemo,
  "python-luhn": LuhnDemo,
  "python-frequency": FrequencyDemo,
};
const Demo = project.data.interactive ? demos[project.slug] : undefined;

const categoryLabels: Record<string, string> = {
  "ml-ai": "AI / ML",
  data: "Data",
  systems: "Systems",
  web: "Web",
  fundamentals: "Fundamentals",
};
---

<Layout title={`${title} — Neil Fernandez`} description={project.data.description}>
  <Nav />
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
    <a
      href="/#projects"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 hover:underline"
    >
      <span aria-hidden="true">&larr;</span> Back to projects
    </a>

    <div class="mt-6 flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        {
          domain && <p class="mt-2 text-slate-500 dark:text-slate-400">{domain}</p>
        }
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span
          class="rounded-full border border-slate-200 px-2.5 py-0.5 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700 dark:text-slate-400"
        >
          {categoryLabels[category] ?? category}
        </span>
        {
          project.data.interactive && (
            <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
              Interactive
            </span>
          )
        }
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {
        tech.map((item) => (
          <span
            class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300"
          >
            {item}
          </span>
        ))
      }
    </div>

    {
      result && (
        <p class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 font-semibold text-brand-700 dark:border-brand-900 dark:bg-brand-900 dark:text-brand-300">
          {result}
        </p>
      )
    }

    {Demo && <Demo />}

    <article class="story mt-8">
      {steps && steps.length > 0 && <StepsFlow steps={steps} />}
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
