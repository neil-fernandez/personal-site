---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featured = allProjects.filter((p) => p.data.featured);
const coursework = allProjects.filter((p) => !p.data.featured);

const skillGroups = [
  { name: "Languages", skills: ["Python", "SQL", "TypeScript"] },
  {
    name: "Machine Learning & AI",
    skills: ["scikit-learn", "PyTorch", "LLMs & RAG", "computer vision", "recommender systems"],
  },
  { name: "Data & Databases", skills: ["pandas", "SQL", "ETL", "data visualization"] },
  { name: "Cloud & Infrastructure", skills: ["AWS", "Docker", "CI/CD"] },
  { name: "Software", skills: ["testing", "secure coding", "MLOps", "Flask"] },
];
---

<Layout
  title="Neil Fernandez | AI and Robotics Hobbyist"
  description="AI and robotics hobbyist engineering new automated systems across machine learning, data, and cloud."
>
  <Nav />
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
    <section class="py-6">
      <div class="flex items-center gap-5">
        <span
          class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-brand-600 text-2xl font-bold text-white"
          aria-hidden="true"
        >
          NF
        </span>
        <div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Neil Fernandez</h1>
          <p class="mt-1 text-sm uppercase tracking-widest text-slate-500 dark:text-slate-400">
            AI and Robotics Hobbyist
          </p>
        </div>
      </div>
      <p class="mt-5 text-lg text-slate-700 dark:text-slate-300">
        Engineering new automated systems
      </p>
      <a
        href="#contact"
        class="mt-6 inline-block rounded-full bg-brand-600 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Get in touch
      </a>
    </section>

    <section id="about" class="py-8">
      <h2 class="text-2xl font-semibold">About</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">
        I'm an engineer who connects transformation, analytics, and automation to turn data into
        decisions and ideas into working systems. I build across machine learning and AI, data and
        databases, and cloud and delivery infrastructure. Beyond engineering, I'm drawn to robotics
         and autonomous systems, wildlife rescue, and STEM teaching.
      </p>
    </section>

    <section id="goals" class="py-8">
      <h2 class="text-2xl font-semibold">What I'm working toward</h2>
      <ul class="mt-4 space-y-2 text-slate-700 dark:text-slate-300">
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-brand-600">&rarr;</span>
          <span>Build toward robotics and autonomous systems.</span>
        </li>
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-brand-600">&rarr;</span>
          <span>Apply AI/ML and automation to real production problems.</span>
        </li>
        <li class="flex gap-2">
          <span aria-hidden="true" class="text-brand-600">&rarr;</span>
          <span>Keep contributing to wildlife rescue and STEM teaching.</span>
        </li>
      </ul>
    </section>

    <section id="projects" class="py-8">
      <h2 class="text-2xl font-semibold">Projects</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="coursework" class="py-8">
      <h2 class="text-2xl font-semibold">Coursework</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Selected academic work across software concepts, data, and machine learning.
      </p>
      <ul class="mt-6 space-y-4">
        {
          coursework.map((project) => (
            <li class="border-b border-slate-200 pb-4 last:border-0 dark:border-slate-800">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold">{project.data.title}</h3>
                <span class="text-xs text-slate-500 dark:text-slate-400">{project.data.domain}</span>
              </div>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{project.data.description}</p>
              {
                project.data.topics && (
                  <ul class="mt-2 list-inside list-disc text-xs text-slate-500 dark:text-slate-400">
                    {project.data.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                )
              }
              <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
                {project.data.tech.join(" · ")}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="skills" class="py-8">
      <h2 class="text-2xl font-semibold">Skills</h2>
      <div class="mt-6 space-y-5">
        {
          skillGroups.map((group) => (
            <div>
              <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">{group.name}</h3>
              <ul class="mt-2 flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <li class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="contact" class="py-8">
      <h2 class="text-2xl font-semibold">Contact</h2>
      <ul class="mt-4 space-y-2 text-slate-700 dark:text-slate-300">
        <li>
          <a href="mailto:nfern2@gmail.com" class="text-brand-600 underline-offset-2 hover:underline">
            nfern2@gmail.com
          </a>
        </li>
        <li>
          <a
            href="http://au.linkedin.com/in/nkfernandez"
            rel="noopener"
            class="text-brand-600 underline-offset-2 hover:underline"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
