---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).filter((p) => p.data.featured);
---

<Layout
  title="Neil Fernandez | Transformation · Analytics · Automation"
  description="Engineer connecting data and models to decisions and production systems."
>
  <Nav />
  <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
    <section class="py-6">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Neil Fernandez</h1>
      <p class="mt-3 text-sm uppercase tracking-widest text-slate-500 dark:text-slate-400">
        Transformation | Analytics | Automation
      </p>
      <p class="mt-5 text-lg text-slate-700 dark:text-slate-300">
        Engineer connecting data and models to decisions and production systems.
      </p>
      <a
        href="#contact"
        class="mt-6 inline-block rounded-full bg-brand-600 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Get in touch
      </a>
    </section>

    <section id="about" class="py-8">
      <h2 class="text-2xl font-semibold">About</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">
        I'm an engineer who connects transformation, analytics, and automation to turn data into
        decisions and ideas into working systems. I build across machine learning and AI, data and
        databases, and cloud and delivery infrastructure. Beyond engineering, I'm drawn to robotics
        and autonomous systems, wildlife rescue, and STEM teaching.
      </p>
    </section>

    <section id="projects" class="py-8">
      <h2 class="text-2xl font-semibold">Projects</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="contact" class="py-8">
      <h2 class="text-2xl font-semibold">Contact</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">
        <a href="mailto:hello@neilf.org" class="text-brand-600 underline-offset-2 hover:underline">
          hello@neilf.org
        </a>
      </p>
    </section>
  </main>
</Layout>
