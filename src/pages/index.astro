---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StepsFlow from "../components/StepsFlow.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const pythonProjects = allProjects
  .filter((p) => p.data.group === "python")
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const coursework = allProjects.filter((p) => !p.data.featured && p.data.group !== "python");

const interests = [
  "Building robots and autonomous systems",
  "Applying AI and automation to problems I care about",
  "Teaching STEM and sharing what I learn",
];

const skillGroups = [
  { name: "Languages", skills: ["Python", "SQL", "TypeScript"] },
  {
    name: "Machine Learning & AI",
    skills: ["scikit-learn", "PyTorch", "LLMs & RAG", "computer vision", "recommender systems"],
  },
  { name: "Data & Databases", skills: ["pandas", "SQL", "ETL", "data visualization"] },
  { name: "Cloud & Infrastructure", skills: ["AWS", "Docker", "CI/CD"] },
  { name: "Software", skills: ["testing", "secure coding", "MLOps", "Flask"] },
];
---

<Layout
  title="Neil Fernandez | AI and Robotics Engineer"
  description="AI and robotics engineer building new automated systems across machine learning, data, and cloud."
>
  <Nav />
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
    <section class="py-6">
      <div class="flex items-center gap-5">
        <span
          class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-brand-600 text-2xl font-bold text-white"
          aria-hidden="true"
        >
          NF
        </span>
        <div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Neil Fernandez</h1>
          <p class="mt-1 text-sm uppercase tracking-widest text-slate-500 dark:text-slate-400">
            AI and Robotics Engineer
          </p>
        </div>
      </div>
      <p class="mt-5 text-lg text-slate-700 dark:text-slate-300">
        I build small AI, automation, and robotics systems to explore ideas — and write up what I
        learn.
      </p>
      <a
        href="#projects"
        class="mt-6 inline-block rounded-full bg-brand-600 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-700"
      >
        See my projects
      </a>
    </section>

    <section id="about" class="py-8">
      <h2 class="text-2xl font-semibold">About</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">
        I'm an engineer who likes taking an idea — a recommender, a face-ID pipeline, a
        question-answering system — and building it end to end, then figuring out what actually made
        it work. Most of my projects sit at the overlap of machine learning, data, and automation.
        Outside of code, I'm most interested in robotics and autonomous systems, and in teaching
        STEM.
      </p>
    </section>

    <section id="interests" class="py-8">
      <h2 class="text-2xl font-semibold">Interests</h2>
      <ul class="mt-4 space-y-2 text-slate-700 dark:text-slate-300">
        {
          interests.map((item) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-brand-600">&rarr;</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="projects" class="py-8">
      <h2 class="text-2xl font-semibold">Projects</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Things I've built, and the story behind each one.
      </p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="python-projects" class="py-8">
      <h2 class="text-2xl font-semibold">Python projects</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Interactive mini-projects from my Python fundamentals coursework — each one runs entirely in
        your browser.
      </p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {pythonProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="coursework" class="py-8">
      <h2 class="text-2xl font-semibold">Core Capabilities</h2>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        What I've been building and utilising, from software concepts to machine learning.
      </p>
      <ul class="mt-6 space-y-4">
        {
          coursework.map((project) => (
            <li class="border-b border-slate-200 pb-4 last:border-0 dark:border-slate-800">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold">{project.data.title}</h3>
                {
                  project.data.domain && (
                    <span class="text-xs text-slate-500 dark:text-slate-400">{project.data.domain}</span>
                  )
                }
              </div>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{project.data.description}</p>
              {
                project.data.steps && <StepsFlow steps={project.data.steps} />
              }
              {
                project.data.topics && (
                  <ul class="mt-2 list-inside list-disc text-xs text-slate-500 dark:text-slate-400">
                    {project.data.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                )
              }
              <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
                {project.data.tech.join(" · ")}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="skills" class="py-8">
      <h2 class="text-2xl font-semibold">Tools I reach for</h2>
      <div class="mt-6 space-y-5">
        {
          skillGroups.map((group) => (
            <div>
              <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300">{group.name}</h3>
              <ul class="mt-2 flex flex-wrap gap-2">
                {
                  group.skills.map((skill) => (
                    <li class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300">
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="contact" class="py-8">
      <h2 class="text-2xl font-semibold">Say hi</h2>
      <ul class="mt-4 space-y-2 text-slate-700 dark:text-slate-300">
        <li>
          <a href="mailto:nfern2@gmail.com" class="text-brand-600 underline-offset-2 hover:underline">
            nfern2@gmail.com
          </a>
        </li>
        <li>
          <a
            href="http://au.linkedin.com/in/nkfernandez"
            rel="noopener"
            class="text-brand-600 underline-offset-2 hover:underline"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
