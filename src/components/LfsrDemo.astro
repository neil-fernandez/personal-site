---
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
      Interactive demo
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-500">XOR encryption with a shift register</span>
  </div>

  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Upload a small image. A linear-feedback shift register (LFSR) generates a pseudo-random
    keystream, and each pixel byte is XOR-ed with it. Because XOR is symmetric, XOR-ing the
    encrypted bytes with the same keystream restores the original exactly.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <label class="cursor-pointer rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-700">
      Choose an image
      <input id="lfsr-file" type="file" accept="image/*" class="hidden" />
    </label>
    <label class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
      Seed
      <input id="lfsr-seed" type="number" min="1" max="255" value="29" class="w-16 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800" />
    </label>
    <button id="lfsr-again" type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-brand-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
      New seed
    </button>
  </div>

  <div class="mt-4 grid grid-cols-3 gap-3">
    <div>
      <canvas id="lfsr-orig" width="144" height="144" class="w-full rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"></canvas>
      <p class="mt-1 text-center text-[11px] text-slate-400 dark:text-slate-500">Original</p>
    </div>
    <div>
      <canvas id="lfsr-enc" width="144" height="144" class="w-full rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"></canvas>
      <p class="mt-1 text-center text-[11px] text-slate-400 dark:text-slate-500">Encrypted</p>
    </div>
    <div>
      <canvas id="lfsr-dec" width="144" height="144" class="w-full rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"></canvas>
      <p class="mt-1 text-center text-[11px] text-slate-400 dark:text-slate-500">Decrypted</p>
    </div>
  </div>

  <p id="lfsr-status" class="mt-3 text-xs text-slate-400 dark:text-slate-500">
    Upload an image to see the round-trip. The encrypted pane should look like noise.
  </p>
</div>

<script>
  const fileInput = document.getElementById("lfsr-file");
  const seedInput = document.getElementById("lfsr-seed");
  const againBtn = document.getElementById("lfsr-again");
  const origCanvas = document.getElementById("lfsr-orig");
  const encCanvas = document.getElementById("lfsr-enc");
  const decCanvas = document.getElementById("lfsr-dec");
  const statusEl = document.getElementById("lfsr-status");

  let grayBytes = null;

  // 8-bit maximal-length LFSR (polynomial x^8 + x^6 + x^5 + x^4 + 1).
  function lfsrStream(seed, length) {
    let s = (seed >>> 0) & 0xff;
    if (s === 0) s = 0x9d;
    const out = new Uint8Array(length);
    for (let i = 0; i < length; i++) {
      let b = 0;
      for (let j = 0; j < 8; j++) {
        const bit = ((s >> 7) ^ (s >> 5) ^ (s >> 3) ^ (s >> 2)) & 1;
        s = ((s << 1) | bit) & 0xff;
        b = (b << 1) | bit;
      }
      out[i] = b;
    }
    return out;
  }

  function drawBytes(canvas, bytes) {
    const ctx = canvas.getContext("2d");
    const img = ctx.createImageData(canvas.width, canvas.height);
    for (let i = 0; i < bytes.length; i++) {
      img.data[i * 4] = bytes[i];
      img.data[i * 4 + 1] = bytes[i];
      img.data[i * 4 + 2] = bytes[i];
      img.data[i * 4 + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
  }

  function apply(seed) {
    if (!grayBytes) return;
    const key = lfsrStream(seed, grayBytes.length);
    const encrypted = new Uint8Array(grayBytes.length);
    for (let i = 0; i < grayBytes.length; i++) encrypted[i] = grayBytes[i] ^ key[i];
    drawBytes(origCanvas, grayBytes);
    drawBytes(encCanvas, encrypted);
    drawBytes(decCanvas, encrypted.map((b, i) => b ^ key[i]));
    statusEl.textContent = "Seed " + (seed >>> 0) + " · " + grayBytes.length + " bytes processed. Decrypted pane should match the original.";
  }

  function loadImage(file) {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const off = document.createElement("canvas");
      off.width = origCanvas.width;
      off.height = origCanvas.height;
      const ctx = off.getContext("2d");
      ctx.drawImage(img, 0, 0, off.width, off.height);
      const data = ctx.getImageData(0, 0, off.width, off.height).data;
      grayBytes = new Uint8Array(off.width * off.height);
      for (let i = 0; i < grayBytes.length; i++) {
        const r = data[i * 4];
        const g = data[i * 4 + 1];
        const b = data[i * 4 + 2];
        grayBytes[i] = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
      }
      URL.revokeObjectURL(url);
      apply(parseInt(seedInput.value, 10) || 1);
    };
    img.src = url;
  }

  fileInput.addEventListener("change", () => {
    const file = fileInput.files && fileInput.files[0];
    if (file) loadImage(file);
  });

  againBtn.addEventListener("click", () => {
    seedInput.value = String(1 + Math.floor(Math.random() * 254));
    apply(parseInt(seedInput.value, 10) || 1);
  });

  seedInput.addEventListener("change", () => {
    apply(parseInt(seedInput.value, 10) || 1);
  });
</script>
