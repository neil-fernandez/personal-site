---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<div class="mt-3">
  <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">
    How it works
  </p>
  <ol class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-2 text-xs" aria-label="How it works">
    {
      steps.map((step, i) => (
        <li class="flex items-center gap-1.5">
          <span
            class="flex items-center gap-1.5 rounded-full border border-slate-200 bg-white py-1 pl-1.5 pr-2.5 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            <span
              class="flex h-4 w-4 items-center justify-center rounded-full bg-brand-600 text-[10px] font-semibold leading-none text-white"
            >
              {i + 1}
            </span>
            {step}
          </span>
          {
            i < steps.length - 1 && (
              <span aria-hidden="true" class="text-slate-400 dark:text-slate-500">&rarr;</span>
            )
          }
        </li>
      ))
    }
  </ol>
</div>
