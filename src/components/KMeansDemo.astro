---
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
      Interactive demo
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-500">runs k-means in your browser</span>
  </div>

  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Click in the plot to place points (or add random ones), choose how many clusters you want, then
    run k-means and watch the centroids settle. Points are recoloured by whichever centroid is
    nearest, then the centroids move to the mean of their cluster and the loop repeats.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button id="km-add" type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-brand-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
      Add 20 random points
    </button>
    <button id="km-run" type="button" class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-700">
      Run k-means
    </button>
    <button id="km-clear" type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-brand-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
      Clear
    </button>
    <label class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
      k =
      <input id="km-k" type="number" min="2" max="6" value="3" class="w-14 rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800" />
    </label>
  </div>

  <div class="mt-4 rounded-lg border border-slate-200 bg-white p-1 dark:border-slate-700 dark:bg-slate-800">
    <svg id="km-svg" viewBox="0 0 400 300" class="block h-auto w-full cursor-crosshair" role="img" aria-label="K-means clustering plot">
      <rect x="0" y="0" width="400" height="300" fill="transparent" />
    </svg>
  </div>

  <p id="km-status" class="mt-2 text-xs text-slate-400 dark:text-slate-500">
    Click in the plot to add points, then press "Run k-means".
  </p>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const COLORS = ["#3b82f6", "#10b981", "#f59e0b", "#f43f5e", "#8b5cf6", "#06b6d4"];
  const svg = document.getElementById("km-svg");
  const addBtn = document.getElementById("km-add");
  const runBtn = document.getElementById("km-run");
  const clearBtn = document.getElementById("km-clear");
  const kInput = document.getElementById("km-k");
  const statusEl = document.getElementById("km-status");

  let points = [];
  let assignments = [];
  let centroids = [];

  function el(name, attrs) {
    const node = document.createElementNS(NS, name);
    for (const k in attrs) node.setAttribute(k, attrs[k]);
    return node;
  }

  function toViewBox(evt) {
    const r = svg.getBoundingClientRect();
    return {
      x: ((evt.clientX - r.left) / r.width) * 400,
      y: ((evt.clientY - r.top) / r.height) * 300,
    };
  }

  function render() {
    svg.replaceChildren();
    svg.appendChild(el("rect", { x: 0, y: 0, width: 400, height: 300, fill: "transparent" }));
    points.forEach((p, i) => {
      const color = assignments[i] >= 0 ? COLORS[assignments[i] % COLORS.length] : "#94a3b8";
      svg.appendChild(el("circle", { cx: p.x, cy: p.y, r: 4, fill: color }));
    });
    centroids.forEach((c, ci) => {
      const color = COLORS[ci % COLORS.length];
      svg.appendChild(el("circle", { cx: c.x, cy: c.y, r: 8, fill: "none", stroke: color, "stroke-width": 2.5 }));
      svg.appendChild(el("line", { x1: c.x - 5, y1: c.y - 5, x2: c.x + 5, y2: c.y + 5, stroke: color, "stroke-width": 2 }));
      svg.appendChild(el("line", { x1: c.x - 5, y1: c.y + 5, x2: c.x + 5, y2: c.y - 5, stroke: color, "stroke-width": 2 }));
    });
  }

  function runKMeans(k) {
    if (points.length < k) {
      statusEl.textContent = "Add at least " + k + " points first.";
      return;
    }

    // Initialise centroids by repeatedly picking the point farthest from current centroids.
    const start = points[Math.floor(Math.random() * points.length)];
    centroids = [{ x: start.x, y: start.y }];
    while (centroids.length < k) {
      let best = null;
      let bestD = -1;
      for (const p of points) {
        let d = Infinity;
        for (const c of centroids) {
          const dx = p.x - c.x;
          const dy = p.y - c.y;
          d = Math.min(d, dx * dx + dy * dy);
        }
        if (d > bestD) {
          bestD = d;
          best = p;
        }
      }
      centroids.push({ x: best.x, y: best.y });
    }

    let iterations = 0;
    for (let it = 0; it < 40; it++) {
      iterations = it + 1;
      assignments = points.map((p) => {
        let bi = 0;
        let bd = Infinity;
        centroids.forEach((c, ci) => {
          const dx = p.x - c.x;
          const dy = p.y - c.y;
          const d = dx * dx + dy * dy;
          if (d < bd) {
            bd = d;
            bi = ci;
          }
        });
        return bi;
      });

      const sums = centroids.map(() => ({ x: 0, y: 0, n: 0 }));
      points.forEach((p, i) => {
        const ci = assignments[i];
        sums[ci].x += p.x;
        sums[ci].y += p.y;
        sums[ci].n += 1;
      });

      let moved = false;
      centroids.forEach((c, ci) => {
        if (sums[ci].n === 0) return;
        const nx = sums[ci].x / sums[ci].n;
        const ny = sums[ci].y / sums[ci].n;
        if (Math.abs(nx - c.x) + Math.abs(ny - c.y) > 0.01) moved = true;
        c.x = nx;
        c.y = ny;
      });
      if (!moved) break;
    }

    statusEl.textContent =
      "Converged in " + iterations + " iterations with k = " + k + ". Each X marks a cluster centroid.";
    render();
  }

  svg.addEventListener("click", (evt) => {
    const p = toViewBox(evt);
    if (p.x < 6 || p.x > 394 || p.y < 6 || p.y > 294) return;
    points.push(p);
    assignments.push(-1);
    render();
  });

  addBtn.addEventListener("click", () => {
    for (let i = 0; i < 20; i++) {
      points.push({ x: 10 + Math.random() * 380, y: 10 + Math.random() * 280 });
      assignments.push(-1);
    }
    statusEl.textContent = "Added 20 random points. Press \"Run k-means\".";
    render();
  });

  runBtn.addEventListener("click", () => {
    const k = Math.max(2, Math.min(6, parseInt(kInput.value, 10) || 3));
    runKMeans(k);
  });

  clearBtn.addEventListener("click", () => {
    points = [];
    assignments = [];
    centroids = [];
    statusEl.textContent = "Click in the plot to add points, then press \"Run k-means\".";
    render();
  });

  // Seed a few points so the demo works instantly.
  addBtn.click();
</script>
