---
import { movies } from "../data/movies";

const sorted = [...movies].sort((a, b) => b.popularity - a.popularity);
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
      Interactive demo
    </span>
    <div class="flex items-center gap-3">
      <span class="text-xs text-slate-400 dark:text-slate-500">trains real SVD in your browser</span>
      <button
        id="mm-clear"
        type="button"
        class="text-xs font-medium text-brand-600 hover:underline"
      >
        Clear
      </button>
    </div>
  </div>

  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Pick a few films you like and MovieMate will suggest what to watch next. When the page loads it
    trains a real matrix-factorisation (SVD) recommender on a small sample rating matrix, then ranks
    films by their latent similarity to your picks.
  </p>

  <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-800">
    <h3 class="text-sm font-semibold">Recommended for you</h3>
    <p id="mm-empty" class="mt-2 text-sm text-slate-400 dark:text-slate-500">
      Pick some films below to see your recommendations.
    </p>
    <ul id="mm-recs" class="mt-3 flex gap-3 overflow-x-auto pb-2"></ul>
  </div>

  <div class="mt-5">
    <h3 class="text-sm font-semibold">Pick films you like</h3>
    <div id="mm-selected" class="mt-2 flex min-h-[2rem] flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400"></div>
    <div id="mm-grid" class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
      {
        sorted.map((m) => (
          <button
            type="button"
            data-title={m.title}
            class="mm-movie rounded-lg border border-slate-200 bg-white px-3 py-2 text-left text-sm transition-colors hover:border-brand-300 dark:border-slate-700 dark:bg-slate-800"
          >
            <span class="block font-medium leading-tight">{m.title}</span>
            <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
              {m.genres.join(" · ")}
            </span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script define:vars={{ movies }}>
  const MAX_PICKS = 5;
  const selected = new Set();
  const grid = document.getElementById("mm-grid");
  const selectedEl = document.getElementById("mm-selected");
  const recsEl = document.getElementById("mm-recs");
  const emptyEl = document.getElementById("mm-empty");
  const clearBtn = document.getElementById("mm-clear");

  // --- SVD collaborative filtering (biased matrix factorisation via SGD) ---
  const N_USERS = 60;
  const LATENT = 10;
  const genreList = [...new Set(movies.flatMap((m) => m.genres))];

  function seededRandom(seed) {
    let s = seed >>> 0;
    return () => {
      s = (s * 1664525 + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }
  const rng = seededRandom(20240918);

  const ratings = [];
  {
    const prefs = Array.from({ length: N_USERS }, () => {
      const p = {};
      for (const g of genreList) p[g] = rng() * 2 - 1;
      return p;
    });
    movies.forEach((m, i) => {
      prefs.forEach((p, u) => {
        if (rng() < 0.42) return;
        let s = 0;
        for (const g of m.genres) s += p[g];
        const r = 2.8 + s * 1.3 + (rng() - 0.5) * 1.3;
        ratings.push([u, i, Math.max(1, Math.min(5, Math.round(r * 10) / 10))]);
      });
    });
  }

  function trainSVD() {
    const nu = N_USERS;
    const ni = movies.length;
    const k = LATENT;
    const mu = ratings.reduce((a, r) => a + r[2], 0) / ratings.length;
    const U = Array.from({ length: nu }, () => Array.from({ length: k }, () => rng() * 0.1 - 0.05));
    const V = Array.from({ length: ni }, () => Array.from({ length: k }, () => rng() * 0.1 - 0.05));
    const bu = new Array(nu).fill(0);
    const bi = new Array(ni).fill(0);
    let lr = 0.012;
    const reg = 0.02;
    for (let e = 0; e < 30; e++) {
      for (let i = ratings.length - 1; i > 0; i--) {
        const j = (rng() * (i + 1)) | 0;
        const tmp = ratings[i];
        ratings[i] = ratings[j];
        ratings[j] = tmp;
      }
      for (const r of ratings) {
        const u = r[0], i = r[1], rating = r[2];
        let p = mu + bu[u] + bi[i];
        const Uu = U[u], Vi = V[i];
        for (let f = 0; f < k; f++) p += Uu[f] * Vi[f];
        const err = rating - p;
        bu[u] += lr * (err - reg * bu[u]);
        bi[i] += lr * (err - reg * bi[i]);
        for (let f = 0; f < k; f++) {
          const uf = Uu[f], vf = Vi[f];
          Uu[f] += lr * (err * vf - reg * uf);
          Vi[f] += lr * (err * uf - reg * vf);
        }
      }
      lr *= 0.96;
    }
    return V;
  }

  const V = trainSVD();

  const ICONS = {
    film: '<rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/>',
    heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
    zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
    smile: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
    moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
    music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
    star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
    search: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
    users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    globe: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
    play: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  };

  const GENRE = {
    Romance: { icon: "heart", bg: "bg-rose-100 dark:bg-rose-900/50", text: "text-rose-600 dark:text-rose-300" },
    Comedy: { icon: "smile", bg: "bg-amber-100 dark:bg-amber-900/50", text: "text-amber-600 dark:text-amber-300" },
    Family: { icon: "users", bg: "bg-teal-100 dark:bg-teal-900/50", text: "text-teal-600 dark:text-teal-300" },
    Horror: { icon: "moon", bg: "bg-purple-100 dark:bg-purple-900/50", text: "text-purple-600 dark:text-purple-300" },
    Music: { icon: "music", bg: "bg-indigo-100 dark:bg-indigo-900/50", text: "text-indigo-600 dark:text-indigo-300" },
    Musical: { icon: "music", bg: "bg-indigo-100 dark:bg-indigo-900/50", text: "text-indigo-600 dark:text-indigo-300" },
    Crime: { icon: "shield", bg: "bg-red-100 dark:bg-red-900/50", text: "text-red-600 dark:text-red-300" },
    Mystery: { icon: "search", bg: "bg-slate-200 dark:bg-slate-800", text: "text-slate-600 dark:text-slate-300" },
    Thriller: { icon: "eye", bg: "bg-orange-100 dark:bg-orange-900/50", text: "text-orange-600 dark:text-orange-300" },
    "Sci-Fi": { icon: "globe", bg: "bg-blue-100 dark:bg-blue-900/50", text: "text-blue-600 dark:text-blue-300" },
    Fantasy: { icon: "star", bg: "bg-violet-100 dark:bg-violet-900/50", text: "text-violet-600 dark:text-violet-300" },
    Animation: { icon: "play", bg: "bg-green-100 dark:bg-green-900/50", text: "text-green-600 dark:text-green-300" },
    Action: { icon: "zap", bg: "bg-orange-100 dark:bg-orange-900/50", text: "text-orange-600 dark:text-orange-300" },
    Adventure: { icon: "compass", bg: "bg-emerald-100 dark:bg-emerald-900/50", text: "text-emerald-600 dark:text-emerald-300" },
    Drama: { icon: "film", bg: "bg-slate-200 dark:bg-slate-800", text: "text-slate-600 dark:text-slate-300" },
  };

  function genresOf(title) {
    return movies.find((m) => m.title === title)?.genres ?? [];
  }

  function iconSvg(name) {
    const body = ICONS[name] ?? ICONS.film;
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">' + body + "</svg>";
  }

  function renderSelected() {
    selectedEl.innerHTML = "";
    for (const title of selected) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className =
        "rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white transition-colors hover:bg-brand-700";
      chip.textContent = title + "  ✕";
      chip.addEventListener("click", () => {
        selected.delete(title);
        sync();
        recommend();
      });
      selectedEl.appendChild(chip);
    }
  }

  function sync() {
    for (const btn of grid.querySelectorAll(".mm-movie")) {
      const on = selected.has(btn.dataset.title);
      btn.classList.toggle("ring-2", on);
      btn.classList.toggle("ring-brand-600", on);
      btn.classList.toggle("border-transparent", on);
    }
  }

  function renderRecs(recs) {
    recsEl.innerHTML = "";
    for (const { movie, reason, matchText } of recs) {
      const primary = movie.genres[0];
      const style = GENRE[primary] ?? GENRE.Drama;
      const isMatch = matchText.indexOf("Match") !== -1;

      const li = document.createElement("li");
      li.className = "w-44 shrink-0";

      const card = document.createElement("div");
      card.className =
        "flex h-full flex-col rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800";

      const top = document.createElement("div");
      top.className = "flex items-start justify-between gap-2";

      const tile = document.createElement("span");
      tile.className = "flex h-11 w-11 items-center justify-center rounded-lg " + style.bg + " " + style.text;
      tile.innerHTML = iconSvg(style.icon);

      const badge = document.createElement("span");
      badge.className =
        "rounded px-1.5 py-0.5 text-[10px] font-bold leading-none text-white " +
        (isMatch ? "bg-emerald-500" : "bg-brand-600");
      badge.textContent = matchText;

      top.append(tile, badge);

      const title = document.createElement("p");
      title.className = "mt-2 font-semibold leading-tight";
      title.textContent = movie.title;

      const genres = document.createElement("p");
      genres.className = "mt-0.5 text-xs text-slate-500 dark:text-slate-400";
      genres.textContent = movie.genres.join(" · ");

      const why = document.createElement("p");
      why.className = "mt-1 text-[11px] leading-snug text-slate-400 dark:text-slate-500";
      why.textContent = reason;

      card.append(top, title, genres, why);
      li.appendChild(card);
      recsEl.appendChild(li);
    }
  }

  function recommend() {
    emptyEl.hidden = selected.size > 0;

    if (selected.size === 0) {
      recsEl.innerHTML = "";
      return;
    }

    const idxOf = (title) => movies.findIndex((m) => m.title === title);
    const userVec = new Array(LATENT).fill(0);
    for (const title of selected) {
      const i = idxOf(title);
      if (i < 0) continue;
      for (let f = 0; f < LATENT; f++) userVec[f] += V[i][f];
    }
    const uNorm = Math.hypot(...userVec) || 1;
    for (let f = 0; f < LATENT; f++) userVec[f] /= uNorm;

    const likedGenres = new Set([...selected].flatMap((t) => genresOf(t)));
    const scored = movies
      .map((movie, i) => {
        if (selected.has(movie.title)) return null;
        let dot = 0, vNorm = 0;
        for (let f = 0; f < LATENT; f++) {
          dot += userVec[f] * V[i][f];
          vNorm += V[i][f] * V[i][f];
        }
        const cosine = dot / (Math.sqrt(vNorm) || 1);
        const shared = movie.genres.filter((g) => likedGenres.has(g));
        return { movie, shared, cosine };
      })
      .filter(Boolean)
      .sort((a, b) => b.cosine - a.cosine);

    const perGenre = new Map();
    const recs = [];
    for (const item of scored) {
      const genre = item.movie.genres[0];
      if ((perGenre.get(genre) ?? 0) >= 2) continue;
      perGenre.set(genre, (perGenre.get(genre) ?? 0) + 1);
      const match = Math.max(50, Math.min(99, Math.round(60 + item.cosine * 45)));
      recs.push({
        movie: item.movie,
        reason: item.shared.length
          ? "Because you like " + item.shared.join(", ")
          : "Similar taste in the latent space",
        matchText: match + "% Match",
      });
      if (recs.length === 8) break;
    }

    renderRecs(recs);
  }

  grid.addEventListener("click", (e) => {
    const btn = e.target.closest(".mm-movie");
    if (!btn) return;
    const title = btn.dataset.title;
    if (selected.has(title)) {
      selected.delete(title);
    } else if (selected.size < MAX_PICKS) {
      selected.add(title);
    }
    sync();
    recommend();
  });

  clearBtn.addEventListener("click", () => {
    selected.clear();
    sync();
    recommend();
  });

  sync();
  recommend();
</script>
