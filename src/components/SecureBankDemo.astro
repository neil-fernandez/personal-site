---
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">Interactive demo</span>
    <span class="text-xs text-slate-400 dark:text-slate-500">prototype scoring model</span>
  </div>
  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Adjust a transaction's details to see its fraud-risk score. This is a simplified rule-based
    scorer — the real system joins three data sources behind injection-hardened SQL.
  </p>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <label class="block text-sm">
      <span class="font-medium">Amount: <span id="sb-amount-label" class="text-slate-500">$120</span></span>
      <input id="sb-amount" type="range" min="0" max="5000" step="20" value="120" class="mt-1 w-full accent-brand-600" />
    </label>
    <label class="block text-sm">
      <span class="font-medium">Account age: <span id="sb-age-label" class="text-slate-500">3 years</span></span>
      <input id="sb-age" type="range" min="0" max="10" step="1" value="3" class="mt-1 w-full accent-brand-600" />
    </label>
    <label class="block text-sm">
      <span class="font-medium">Time of day</span>
      <select id="sb-time" class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800">
        <option value="day">Business hours</option>
        <option value="night">Late night</option>
      </select>
    </label>
    <label class="block text-sm">
      <span class="font-medium">Failed logins: <span id="sb-attempts-label" class="text-slate-500">0</span></span>
      <input id="sb-attempts" type="range" min="0" max="5" step="1" value="0" class="mt-1 w-full accent-brand-600" />
    </label>
    <label class="flex items-center gap-2 text-sm sm:col-span-2">
      <input id="sb-location" type="checkbox" class="h-4 w-4 rounded accent-brand-600" />
      <span>Transaction from an unusual location</span>
    </label>
  </div>

  <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-800">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold">Fraud risk</h3>
      <span id="sb-risk" class="text-sm font-semibold text-emerald-600">Low</span>
    </div>
    <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
      <div id="sb-bar" class="h-full rounded-full bg-emerald-500 transition-all duration-200"></div>
    </div>
  </div>

  <div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-800">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-semibold">Example transaction payload</h3>
      <span class="text-xs text-slate-400 dark:text-slate-500">what the detection workflow receives</span>
    </div>
    <pre
      id="sb-payload"
      class="mt-3 overflow-x-auto rounded-lg bg-slate-900 p-4 text-xs leading-relaxed text-slate-100 dark:bg-slate-950"
    ></pre>
  </div>
</div>

<script>
  const amount = document.getElementById("sb-amount");
  const amountLabel = document.getElementById("sb-amount-label");
  const age = document.getElementById("sb-age");
  const ageLabel = document.getElementById("sb-age-label");
  const time = document.getElementById("sb-time");
  const attempts = document.getElementById("sb-attempts");
  const attemptsLabel = document.getElementById("sb-attempts-label");
  const location = document.getElementById("sb-location");
  const bar = document.getElementById("sb-bar");
  const risk = document.getElementById("sb-risk");
  const payloadEl = document.getElementById("sb-payload");

  const LEVELS = [
    { max: 35, label: "Low", bar: "bg-emerald-500", text: "text-emerald-600" },
    { max: 65, label: "Medium", bar: "bg-amber-500", text: "text-amber-600" },
    { max: 999, label: "High", bar: "bg-red-500", text: "text-red-600" },
  ];

  function update() {
    const amt = Number(amount.value);
    const years = Number(age.value);
    const night = time.value === "night";
    const fails = Number(attempts.value);
    const unusual = location.checked;

    amountLabel.textContent = "$" + amt;
    ageLabel.textContent = years + (years === 1 ? " year" : " years");
    attemptsLabel.textContent = String(fails);

    let score = 0;
    if (amt > 2000) score += 25;
    if (years < 1) score += 20;
    if (night) score += 15;
    if (unusual) score += 25;
    score += fails * 10;
    score = Math.min(100, score);

    const level = LEVELS.find((l) => score < l.max) ?? LEVELS[LEVELS.length - 1];

    bar.style.width = score + "%";
    bar.className = "h-full rounded-full transition-all duration-200 " + level.bar;
    risk.textContent = level.label;
    risk.className = "text-sm font-semibold " + level.text;

    const payload = {
      transaction_id: "TXN-8823147",
      account_id: "ACC-4419026",
      timestamp: night ? "2026-09-18T02:47:11+10:00" : "2026-09-18T10:24:36+10:00",
      amount: Number(amt.toFixed(2)),
      currency: "AUD",
      merchant: unusual ? "Flywire (international transfer)" : "JB Hi-Fi",
      category: unusual ? "international_transfer" : "electronics",
      channel: "online",
      card_present: false,
      location: unusual ? "Bangkok, TH" : "Melbourne, AU",
      device: "iPhone 15, iOS 18",
      account_age_years: years,
      failed_login_attempts: fails,
      unusual_location: unusual,
    };
    payloadEl.textContent = JSON.stringify(payload, null, 2);
  }

  [amount, age, time, attempts, location].forEach((el) =>
    el.addEventListener("input", update),
  );

  update();
</script>
