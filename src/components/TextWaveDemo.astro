---
import { samples } from "../data/faq";
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">Interactive demo</span>
    <span class="text-xs text-slate-400 dark:text-slate-500">runs a real embedding model in your browser</span>
  </div>
  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Ask a question about "Acme Cloud" — a small sample knowledge base. TextWave runs a real
    sentence-embedding model (all-MiniLM-L6-v2) locally and retrieves the most semantically similar
    passage. The full system adds a phi3 / qwen2.5 generator on top.
  </p>

  <div class="mt-4 flex gap-2">
    <input
      id="tw-input"
      type="text"
      placeholder="e.g. How do I get a refund?"
      class="flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"
    />
    <button id="tw-ask" type="button" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700">
      Ask
    </button>
  </div>

  <div class="mt-3">
    <p class="text-xs font-medium text-slate-400 dark:text-slate-500">Or tap a sample question:</p>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        samples.map((s) => (
          <button
            type="button"
            data-q={s}
            class="tw-sample rounded-full border border-slate-200 bg-white px-3 py-1 text-xs text-slate-600 transition-colors hover:border-brand-300 hover:text-brand-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            {s}
          </button>
        ))
      }
    </div>
  </div>

  <div id="tw-output" class="mt-4"></div>
</div>

<script>
  import { faq } from "../data/faq";

  const input = document.getElementById("tw-input");
  const askBtn = document.getElementById("tw-ask");
  const output = document.getElementById("tw-output");

  const HIDDEN = 384;
  const MIN_COSINE = 0.32;
  const SHOW_COSINE = 0.28;

  let ort = null;
  let session = null;
  let vocabMap = null;
  let faqQ = null;
  let faqA = null;
  let loading = null;

  async function loadModel() {
    if (loading) return loading;
    loading = (async () => {
      const m = await import("onnxruntime-web/wasm");
      m.env.wasm.wasmPaths = "/ort/";
      m.env.wasm.numThreads = 1;
      const [vocabText, sess] = await Promise.all([
        fetch("/models/minilm/vocab.txt").then((r) => r.text()),
        m.InferenceSession.create("/models/minilm/model.onnx", { executionProviders: ["wasm"] }),
      ]);
      vocabMap = new Map(vocabText.split(/\r?\n/).filter(Boolean).map((t, i) => [t, i]));
      session = sess;
      ort = m;
      return m;
    })();
    return loading;
  }

  function wordpiece(word) {
    if (vocabMap.has(word)) return [word];
    const sub = [];
    let start = 0;
    while (start < word.length) {
      let end = word.length;
      let cur = null;
      while (start < end) {
        const candidate = (start > 0 ? "##" : "") + word.slice(start, end);
        if (vocabMap.has(candidate)) { cur = candidate; break; }
        end--;
      }
      if (!cur) return null;
      sub.push(cur);
      start = end;
    }
    return sub;
  }

  function tokenIds(text) {
    const unk = vocabMap.get("[UNK]");
    const cls = vocabMap.get("[CLS]");
    const sep = vocabMap.get("[SEP]");
    const words = text.toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, " ").split(/\s+/).filter(Boolean);
    const ids = [cls];
    for (const w of words) {
      const sub = wordpiece(w);
      if (sub) ids.push(...sub.map((t) => vocabMap.get(t)));
      else ids.push(unk);
    }
    ids.push(sep);
    return ids;
  }

  async function embed(text) {
    const ids = tokenIds(text);
    const seq = ids.length;
    const inputIds = new BigInt64Array(seq);
    const mask = new BigInt64Array(seq);
    const tokenTypes = new BigInt64Array(seq);
    for (let i = 0; i < seq; i++) {
      inputIds[i] = BigInt(ids[i]);
      mask[i] = 1n;
      tokenTypes[i] = 0n;
    }
    const feeds = {
      input_ids: new ort.Tensor("int64", inputIds, [1, seq]),
      attention_mask: new ort.Tensor("int64", mask, [1, seq]),
      token_type_ids: new ort.Tensor("int64", tokenTypes, [1, seq]),
    };
    const res = await session.run(feeds);
    const out = res.last_hidden_state;
    const data = out.data;
    const vec = new Float32Array(HIDDEN);
    for (let t = 0; t < seq; t++) {
      for (let d = 0; d < HIDDEN; d++) vec[d] += data[t * HIDDEN + d];
    }
    let norm = 0;
    for (let d = 0; d < HIDDEN; d++) norm += vec[d] * vec[d];
    norm = Math.sqrt(norm) || 1;
    for (let d = 0; d < HIDDEN; d++) vec[d] /= norm;
    return vec;
  }

  function cosine(a, b) {
    let s = 0;
    for (let i = 0; i < HIDDEN; i++) s += a[i] * b[i];
    return s;
  }

  async function ensureEmbeddings() {
    if (faqQ) return;
    faqQ = [];
    faqA = [];
    for (const f of faq) {
      faqQ.push(await embed(f.q));
      faqA.push(await embed(f.a));
    }
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  }

  async function run() {
    const q = input.value.trim();
    if (!q) return;

    output.innerHTML = '<p class="text-sm text-slate-400 dark:text-slate-500">Loading embedding model…</p>';
    try {
      await loadModel();
      await ensureEmbeddings();
      const qvec = await embed(q);

      const scored = faq
        .map((f, i) => ({ ...f, cosine: Math.max(cosine(qvec, faqQ[i]), cosine(qvec, faqA[i])) }))
        .sort((a, b) => b.cosine - a.cosine);

      const relevant = scored.filter((s) => s.cosine >= SHOW_COSINE);
      const top = relevant[0];

      if (!top || top.cosine < MIN_COSINE) {
        const block = document.createElement("div");
        block.innerHTML =
          '<p class="text-sm text-slate-600 dark:text-slate-300">No relevant passage found in the knowledge base.</p>' +
          '<p class="mt-1 text-xs text-slate-400 dark:text-slate-500">The retriever honestly reports a miss instead of guessing. Its knowledge is only the small Acme Cloud FAQ here — tap one of the sample questions above, or ask about password reset, refunds, cost, deployment, the free tier, support, privacy, or uptime.</p>';
        output.replaceChildren(block);
        return;
      }

      const retrieved = document.createElement("div");
      retrieved.className = "space-y-2";

      const label = document.createElement("p");
      label.className = "text-xs font-semibold uppercase tracking-wide text-slate-400";
      label.textContent = "Retrieved passages";
      retrieved.appendChild(label);

      for (const f of relevant.slice(0, 3)) {
        const pct = Math.round(f.cosine * 100);
        const item = document.createElement("div");
        item.className =
          "rounded-lg border p-3 " +
          (f === top ? "border-brand-300 bg-white dark:border-brand-700 dark:bg-slate-800" : "border-slate-200 bg-white/60 dark:border-slate-700 dark:bg-slate-800/50");
        item.innerHTML =
          '<div class="flex items-center justify-between gap-2">' +
          '<p class="text-sm font-medium text-slate-700 dark:text-slate-200">' + escapeHtml(f.q) + "</p>" +
          '<span class="shrink-0 text-xs font-semibold text-brand-600">' + pct + "% match</span>" +
          "</div>" +
          '<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">' + escapeHtml(f.a) + "</p>";
        retrieved.appendChild(item);
      }

      const answer = document.createElement("div");
      answer.className = "mt-3 rounded-lg border border-brand-200 bg-brand-50 p-3 dark:border-brand-900 dark:bg-brand-900/30";
      answer.innerHTML =
        '<p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Generated answer</p>' +
        '<p class="mt-1 text-sm text-slate-700 dark:text-slate-200">' + escapeHtml(top.a) + "</p>";

      const wrapper = document.createElement("div");
      wrapper.append(retrieved, answer);
      output.replaceChildren(wrapper);
    } catch (e) {
      console.error(e);
      output.innerHTML = '<p class="text-sm text-red-600 dark:text-red-400">Could not load the embedding model in this browser.</p>';
    }
  }

  askBtn.addEventListener("click", run);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") run();
  });

  document.querySelectorAll(".tw-sample").forEach((btn) => {
    btn.addEventListener("click", () => {
      input.value = btn.dataset.q;
      run();
    });
  });

  // Warm up the model in the background so the first search is fast.
  loadModel().catch(() => {});
</script>
