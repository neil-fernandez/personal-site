---
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="flex items-center justify-between gap-3">
    <span class="rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-white">
      Interactive demo
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-500">letter frequency analysis in your browser</span>
  </div>

  <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
    Paste some text and it counts how often each letter appears, then compares the shape to typical
    English (where "E" dominates). That same idea is the first step in breaking a simple Caesar
    cipher: if the most common letter is probably "E", you can guess the shift.
  </p>

  <div class="mt-4">
    <textarea
      id="freq-input"
      rows="4"
      placeholder="Paste a paragraph of English text here…"
      class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"
    ></textarea>
    <div class="mt-2 flex flex-wrap gap-2">
      <button id="freq-analyze" type="button" class="rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-700">
        Analyse
      </button>
      <button id="freq-sample" type="button" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-brand-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
        Use sample text
      </button>
    </div>
  </div>

  <div id="freq-output" class="mt-4"></div>
</div>

<script>
  const textarea = document.getElementById("freq-input");
  const analyzeBtn = document.getElementById("freq-analyze");
  const sampleBtn = document.getElementById("freq-sample");
  const output = document.getElementById("freq-output");

  const SAMPLE =
    "The quick brown fox jumps over the lazy dog. A few ordinary sentences like this one are enough to reveal that some letters appear far more often than others, and that E is usually the most frequent letter in English text.";

  function analyze(text) {
    const counts = new Map();
    let letters = 0;
    for (const ch of text) {
      const c = ch.toLowerCase();
      if (c >= "a" && c <= "z") {
        counts.set(c, (counts.get(c) || 0) + 1);
        letters++;
      }
    }
    if (letters === 0) {
      output.innerHTML = '<p class="text-sm text-slate-400 dark:text-slate-500">No letters found — paste some text first.</p>';
      return;
    }

    const entries = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    const most = entries[0][0];
    const shift = (most.charCodeAt(0) - "e".charCodeAt(0) + 26) % 26;

    const bars = entries
      .map(([ch, n]) => {
        const pct = Math.round((n / letters) * 1000) / 10;
        return (
          '<div class="flex items-center gap-2">' +
          '<span class="w-4 shrink-0 text-right font-mono text-xs font-semibold uppercase text-slate-600 dark:text-slate-300">' + ch + "</span>" +
          '<div class="h-4 flex-1 overflow-hidden rounded bg-slate-100 dark:bg-slate-800">' +
          '<div class="h-full rounded bg-brand-500" style="width:' + Math.max(2, pct) + '%"></div>' +
          "</div>" +
          '<span class="w-16 shrink-0 text-right font-mono text-[11px] text-slate-500 dark:text-slate-400">' + n + " · " + pct + "%</span>" +
          "</div>"
        );
      })
      .join("");

    output.innerHTML =
      '<p class="text-xs text-slate-500 dark:text-slate-400">' +
      letters + " letters · " + entries.length + " distinct letters" +
      "</p>" +
      '<div class="mt-2 space-y-1">' + bars + "</div>" +
      '<div class="mt-3 rounded-lg border border-brand-200 bg-brand-50 p-3 text-xs text-slate-700 dark:border-brand-900 dark:bg-brand-900/30 dark:text-slate-200">' +
      "Most common letter is <span class=\"font-semibold uppercase\">" + most + "</span>, so a Caesar cipher that shifted every letter by <span class=\"font-semibold\">" + shift + "</span> would make \"" + most + "\" line up with \"E\"." +
      "</div>";
  }

  analyzeBtn.addEventListener("click", () => analyze(textarea.value));
  sampleBtn.addEventListener("click", () => {
    textarea.value = SAMPLE;
    analyze(SAMPLE);
  });

  sampleBtn.click();
</script>
